{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies",
    "safebump"
  ],
  "minimumReleaseAge": "3 days",
  "platformAutomerge": false,
  "automergeType": "pr",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major"
      ]
    },
    {
      "groupName": "query",
      "matchPackageNames": [
        "@tanstack/react-query",
        "@tanstack/react-query-devtools"
      ]
    },
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom"
      ]
    }
  ]
}
